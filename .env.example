# PIN de acceso a la UI (elegí el tuyo en .env.local)
APP_PIN=1234
# Secreto para firmar la cookie de sesión — cambiar por una cadena larga aleatoria
SESSION_SECRET=cambiame-por-32-caracteres-aleatorios
# Ruta del archivo SQLite
DB_PATH=data/bitacora.db

# Google OAuth (crear en Google Cloud Console — ver bitácora)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clave maestra para cifrar los tokens de Google en disco (si falta, usa SESSION_SECRET)
MASTER_PASSWORD=
# URL base de la app (para el redirect de OAuth)
APP_URL=http://localhost:3000

# Voz ElevenLabs (opcional — plan gratis en elevenlabs.io → Profile → API Keys)
ELEVENLABS_API_KEY=

# Buscador local para la estimación de Objetivos. Si no está, la app usa la
# memoria del modelo y lo marca "sin verificar". Ver docker/searxng/compose.yml
SEARXNG_URL=http://localhost:8080
